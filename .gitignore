# =========================================================
# .gitignore
# =========================================================

# ---- Secrets ----
.env
*.env
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Local databases / vector stores ----
storage/
*.db
*.sqlite
*.sqlite3
chromadb/
.chroma_db/
data/chroma/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / editor files ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ---- Logs ----
*.log
logs/

# ---- Test / coverage artifacts ----
.pytest_cache/
.coverage
htmlcov/

# ---- OS files ----
Thumbs.db

# ---- Local AI tooling (Claude Code skill caches, not project source) ----
.claude/
.agents/
