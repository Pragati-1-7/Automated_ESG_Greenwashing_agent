# Copy to .env and fill in. NEVER commit .env.

# ---- Decision engine: TypeSafe Jev ----
TYPESAFE_API_KEY=your_jev_api_key_here
# live   = call Jev and record every answer (default)
# replay = offline, answers must already be recorded in data/cassettes/jev/ (tests, demos without network)
JEV_MODE=live

# ---- Generative text slot: mock (default, deterministic) or groq ----
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- External data services ----
# inproc = mount mock_sources inside the API process; or http://127.0.0.1:8100 for the separate service
MOCK_SOURCES_URL=inproc

# ---- Limits ----
MAX_CLAIMS=40
MAX_INVESTIGATION_ROUNDS=2

# ---- v1 legacy ----
SQLITE_DB_PATH=./storage/app.db
