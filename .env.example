# =========================================================
# .env.example
# Copy this file to ".env" and fill in real values locally.
# NEVER commit the actual ".env" file to GitHub.
# =========================================================

# ---- LLM Providers (used from Phase 2 onward) ----
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ---- Model selection (used from Phase 2 onward) ----
LLM_MODEL_NAME=llama-3.1-70b-versatile

# ---- Vector DB / storage paths (used from Phase 3 onward) ----
CHROMA_PERSIST_DIR=./storage/chromadb
SQLITE_DB_PATH=./storage/app.db

# ---- Web/Search API keys (used from Phase 3 onward, if applicable) ----
SEARCH_API_KEY=your_search_api_key_here

# ---- App configuration ----
APP_ENV=development
LOG_LEVEL=INFO
